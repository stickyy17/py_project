   "source": [
    "import psycopg2\n",
    "from psycopg2.extensions import ISOLATION_LEVEL_AUTOCOMMIT \n",
    "from psycopg2.extras import execute_batch\n",
    "\n",
    "import pandas as pd"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 2,
   "id": "f0deb590-4cff-4c75-8f11-85481ed3fca8",
   "metadata": {},
   "outputs": [],
   "source": [
    "# with open('pwd.txt', 'w') as file:\n",
    "#     file.write(input('Enter the password: '))\n",
    "with open('pwd.txt', 'r') as file:\n",
    "    pwd = file.read()\n",
    "conn = psycopg2.connect(\n",
    "        dbname='postgres',\n",
    "        user='postgres',\n",
    "        password=pwd,\n",
    "        host='localhost',\n",
    "        port='5432')"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 7,
   "id": "837df681-ac94-435b-8669-7a473ab9ab9a",
